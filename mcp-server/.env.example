# ─── Arbo Forms MCP Server ────────────────────────────────────
# Copia como .env y completá los valores reales.

# API key generada en tu app Arbo → sidebar → API Keys
ARBO_API_KEY=arbo_tu_key_aqui

# URL de tu backend Arbo
# Local:      http://localhost:4000/api
# Producción: https://tu-backend.onrender.com/api
ARBO_API_URL=http://localhost:4000/api

# Puerto HTTP (solo para modo SSE/cloud — Render lo setea automáticamente)
# Si no está seteado, el server arranca en modo stdio (para clientes MCP locales)
# PORT=3001
