{
  "name": "rest_api_node_ts_server",
  "version": "1.0.0",
  "description": "Rest API's cn Express y Typescript",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "cross-env NODE_ENV=development npx sequelize-cli db:migrate && cross-env NODE_ENV=development nodemon --ext ts,json --watch src --exec tsx src/index.ts",
    "db:migrate": "cross-env NODE_ENV=development npx sequelize-cli db:migrate",
    "db:rollback": "cross-env NODE_ENV=development npx sequelize-cli db:migrate:undo",
    "db:status": "cross-env NODE_ENV=development npx sequelize-cli db:migrate:status",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "author": "Maximiliano Jimenez Flores",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "colors": "^1.4.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6"
  }
}
