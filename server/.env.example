# ─── Copia este archivo como .env para desarrollo ─────────────
# cp .env.example .env
#
# Para producción: copia como .env.production y completa los valores reales.
# Las variables de la plataforma (Railway, Render, Heroku) se usan directamente
# sin necesidad de archivo .env en el servidor.

# ─── Entorno ──────────────────────────────────────────────────
NODE_ENV=development

# ─── Servidor ─────────────────────────────────────────────────
PORT=4000

# URL del frontend (para CORS)
CLIENT_URL=http://localhost:5173

# ─── Base de datos ────────────────────────────────────────────
# Desarrollo: usa las variables individuales
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arbo_db
DB_USER=postgres
DB_PASSWORD=tu_password

# Producción en PaaS (Railway, Render, Supabase, etc.)
# Cuando DATABASE_URL está definida, las variables DB_* se ignoran.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Auth ─────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_seguro

# ─── IA — Providers (agrega solo los que uses) ────────────────
# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=moonshotai/kimi-k2.6:free
OPENROUTER_DAILY_LIMIT=50

# Groq
GROQ_API_KEY=gsk_...

# Google Gemini
GEMINI_API_KEY=AIza...

# Mistral
MISTRAL_API_KEY=...

# Cohere
COHERE_API_KEY=...
